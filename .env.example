# ============================================================
# NEXUS AI — Telegram Bot Environment Variables
# Copy this file to .env for local development.
# In production, set these values as hosting provider secrets.
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token
ADMIN_USER_IDS=123456789
SUPER_ADMIN_ID=123456789
GROUP_CHAT_ID=-1000000000000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- Google Sheets ---
GOOGLE_CREDENTIALS_FILE=credentials/google_service_account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_API_KEY=your_google_api_key

# --- Scheduler ---
TIMEZONE=Europe/Moscow

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional Google OAuth ---
GOOGLE_OAUTH2_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_oauth_client_secret
